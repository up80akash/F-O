# Core application
APP_NAME=fo-trading-platform
APP_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=trading_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/trading_db

# Redis
REDIS_URL=redis://redis:6379/0

# Broker: Upstox
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/callback
UPSTOX_ACCESS_TOKEN=

# Manual broker REST API (server-side only; disabled by default)
BROKER_API_ENABLED=false
BROKER_API_BASE_URL=
BROKER_API_TOKEN=
BROKER_API_AUTH_HEADER=Authorization
BROKER_API_AUTH_SCHEME=Bearer
BROKER_API_TIMEOUT_SECONDS=10
BROKER_API_QUOTE_PATH=/quote/{symbol}
BROKER_API_QUOTES_PATH=/quotes
BROKER_API_OPTION_CHAIN_PATH=/option-chain
BROKER_API_POSITIONS_PATH=/positions
BROKER_API_ORDERS_PATH=/orders
BROKER_API_ORDER_PATH=/orders/{order_id}
BROKER_API_INSTRUMENTS_PATH=/instruments

# AI
OLLAMA_BASE_URL=http://ollama:11434
AI_MODEL=llama3.1
AI_API_KEY=

# Trading modes
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Risk
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=2
MAX_DAILY_LOSS=0
MAX_RISK_PER_TRADE=0.01
MAX_POSITION_SIZE=0
REQUIRE_STOP_LOSS=true
REQUIRE_TARGET=true

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=example.com

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_MODE=PAPER

# Development
DEBUG=true
